{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "rollup.config.ts", "tsconfig*.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "jest.config.ts"]
    },
    "lint": { "inputs": ["src/**", "tsconfig.json"] },
    "dev": { "cache": false, "persistent": true },
    "storybook": { "cache": false, "persistent": true, "dependsOn": ["^build"] },
    "build-storybook": { "dependsOn": ["^build"], "outputs": ["storybook-static/**"] },
    "clean": { "cache": false }
  }
}
