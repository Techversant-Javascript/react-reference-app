{
  "name": "@techv/tokens",
  "version": "0.1.0",
  "author": "Pranav V K <pranavvk@techversantinfotech.com>",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./global.css": "./dist/global.css",
    "./utility.css": "./dist/utility.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/global.css",
    "./dist/utility.css"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript && tsc -p tsconfig.build.json && cp src/global.css dist/global.css && cp src/utility.css dist/utility.css",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.17.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "~5.4.5",
    "vite": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
